{
  "expo": {
    "name": "レポろく",
    "slug": "reporoku",
    "scheme": "reporoku",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "録音した内容を文字起こしするために使用します",
        "NSMicrophoneUsageDescription": "研修の録音のためにマイクを使用します",
        "NSCameraUsageDescription": "スライドの撮影のためにカメラを使用します"
      },
      "bundleIdentifier": "com.anonymous.reporoku"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "研修の録音のためにマイクを使用します",
          "speechRecognitionPermission": "録音した内容を文字起こしするために使用します"
        }
      ],
      "expo-audio",
      "expo-sqlite"
    ]
  }
}
